{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3dspline-web",
  // Vlastní vstupní bod – obaluje .open-next/worker.js a přidává cache obrázků
  "main": "worker.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    // Optimalizace obrázků pro next/image přes Cloudflare Images
    // https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES"
  },
  // ID nasazené verze – worker.ts ho používá v klíči cache obrázků,
  // aby se po každém deployi obrázky převedly znovu z aktuálních souborů
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  },
  // Odesílání poptávek přes Resend. API klíč RESEND_API_KEY sem nepatří –
  // je uložený jako Secret v Cloudflare (Worker → Settings → Variables and Secrets).
  // Proměnné přidané jen v dashboardu by další deploy smazal, proto jsou tady.
  "vars": {
    "NOTIFY_EMAIL": "info@3dspline.cz",
    "FROM_EMAIL": "3dspline.cz Poptávky <info@3dspline.cz>"
  }
  // Doména 3dspline.cz je k Workeru připojená v dashboardu (Custom domain),
  // www.3dspline.cz přesměrovává Redirect Rule na hlavní doménu.
}
