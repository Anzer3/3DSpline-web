{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3dspline-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    // Optimalizace obrázků pro next/image přes Cloudflare Images
    // https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Nastavení odesílání poptávek (Seznam SMTP). Heslo SMTP_PASS sem nepatří –
  // je uložené jako Secret v Cloudflare (Worker → Settings → Variables and Secrets).
  // Proměnné přidané jen v dashboardu by další deploy smazal, proto jsou tady.
  "vars": {
    "SMTP_HOST": "smtp.seznam.cz",
    "SMTP_PORT": "465",
    "SMTP_SECURE": "true",
    "SMTP_USER": "info@3dspline.cz",
    "NOTIFY_EMAIL": "info@3dspline.cz",
    "FROM_EMAIL": "3dspline.cz Poptávky <info@3dspline.cz>"
  }
  // Doména 3dspline.cz je k Workeru připojená v dashboardu (Custom domain),
  // www.3dspline.cz přesměrovává Redirect Rule na hlavní doménu.
}
