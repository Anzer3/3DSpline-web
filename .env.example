# ==============================================================================
# 3dspline.cz - odesílání poptávek
# ==============================================================================
# Lokálně: zkopírujte do .env.local. Bez RESEND_API_KEY se e-maily v `next dev`
# neodesílají, poptávka se jen vypíše do konzole.
# Produkce (Cloudflare Workers): NOTIFY_EMAIL a FROM_EMAIL jsou ve wrangler.jsonc,
# RESEND_API_KEY je Secret ve Workeru (Settings → Variables and Secrets).

# API klíč z https://resend.com/api-keys (doména 3dspline.cz musí být v Resendu ověřená)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Kam chodí nové poptávky
NOTIFY_EMAIL=info@3dspline.cz

# Odesílatel (musí být na ověřené doméně v Resendu)
FROM_EMAIL="3dspline.cz Poptávky <info@3dspline.cz>"
